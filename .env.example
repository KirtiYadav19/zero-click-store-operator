# Django Production / Render Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database Connection (Render provides DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Local PostgreSQL Fallback Settings (Used when DATABASE_URL is not set)
DB_NAME=zero_click_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# AI Services API Keys
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Location Services API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
